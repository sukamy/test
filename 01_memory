# region 第 8 节：模块、异常和文件读取
print("\n【第 8 节：模块、异常和文件】")
# 模块可以理解为组织代码的单元；用 import 导入后，访问其中的内容。
import math
from pathlib import Path

print("9 的平方根：", math.sqrt(9))
# math 是标准库模块，不需要另行安装。
# import math 后写 math.sqrt(...)；from math import sqrt 后可直接写 sqrt(...)。

# 异常表示执行中出现的问题；只捕获预期要处理的错误，不要随意忽略所有异常。
try:
    invalid_number = int("abc")
except ValueError:
    print("abc 不能转换成整数")

# 读取当前这份讲义，不生成文件，不改动其他资料。
# __file__ 表示当前代码文件的路径，Path 用来方便地操作路径。
# with 会在代码块退出时关闭文件；r 表示只读；UTF-8 指定中文文本的编码。
source_path = Path(__file__)
with source_path.open("r", encoding="utf-8") as source_file:
    first_line = source_file.readline()
print("本文件的第一行：", first_line.strip())
# read() 读取全部内容；readline() 读取一行；strip() 去掉首尾的空白字符。
# w 模式会写入并覆盖已有内容，学习时不要拿原始资料做写入试验。

