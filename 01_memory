# region 第 4 节：for / while 循环
print("\n【第 4 节：循环】")
# for 依次从可迭代对象中取出元素。range() 常用来提供整数序列。
# range(起点, 终点, 步长)：包含起点，不包含终点。
# range(3) 依次提供 0、1、2；range(1, 4) 依次提供 1、2、3。
for number in range(1, 4):
    print("本轮数字：", number)

sum_result = 0
for number in range(1, 4):
    sum_result += number
print("1 到 3 的和：", sum_result)
# 循环中 sum_result 依次变成 1、3、6；初始值必须放在循环外。

# while 在每次执行前检查条件；条件为 True 就继续。
remaining = 3
while remaining > 0:
    print("还剩：", remaining)
    remaining -= 1  # 如果忘记更新，条件可能一直成立，导致死循环。
# 遇到死循环可在终端按 Ctrl+C 中断。
# break 结束整个循环；continue 跳过本轮剩余代码，进入下一轮。

