# region 第 7 节：类、对象、属性和方法
print("\n【第 7 节：类和对象】")
# 类描述一类对象共有的数据和行为；调用类可以创建具体对象。
# 属性保存对象的数据；方法是定义在类中的函数，描述对象的行为。
class Student:
    def __init__(self, name, score):
        # __init__ 在实例创建时初始化属性；self 指向当前实例。
        self.name = name
        self.score = score

    def introduce(self):
        return f"我是{self.name}，成绩是{self.score}分"


first_student = Student("小陈", 86)
second_student = Student("小吴", 92)
print(first_student.name)          # 读取属性。
print(first_student.introduce())  # 调用方法；不需要手动传入 self。
print(second_student.introduce())
# first_student 和 second_student 是不同的对象，各有自己的 name 和 score。

