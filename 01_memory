# region 第 3 节：条件判断
print("\n【第 3 节：条件判断】")
temperature = 28
if temperature >= 30:
    print("比较热")
elif temperature >= 20:
    print("温度适中")
else:
    print("比较凉")
# if 是如果，elif 是否则如果，else 是其他情况。
# 这一组中，只执行第一个满足条件的分支；以上示例输出“温度适中”。
# 冒号后换行，块内通常缩进 4 个空格；同一层代码保持相同缩进。
# 比较：== 等于，!= 不等于，> 大于，>= 大于等于，< 小于，<= 小于等于。
# = 是赋值；== 才是判断是否相等。

has_ticket = True
has_id = False
print(has_ticket and has_id)  # and：两者都成立，结果才成立。
print(has_ticket or has_id)   # or：至少一个成立，结果就成立。
print(not has_ticket)         # not：取反。

