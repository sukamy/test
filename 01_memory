# region 第 6 节：函数、参数和返回值
print("\n【第 6 节：函数】")
# 函数是取了名字、可重复调用的一段代码。def 定义，调用时才执行函数体。
# 定义中的 length、width 是形参；调用时传入的 3、4 是实参。
# return 将结果交给调用处，并结束本次函数调用。
def rectangle_area(length, width):
    area = length * width
    return area


area_result = rectangle_area(3, 4)
print("长方形面积：", area_result)
# print() 负责显示；return 负责返回，两者不同。
# 如果把函数里的 return area 改成 print(area)，函数会显示面积，
# 但没有显式 return，调用结果会是 None，area_result 就不再是 12。
# 函数内部创建的普通变量是局部变量，一般只在函数内部使用。

