# region 第 5 节：列表、元组、字典和集合
print("\n【第 5 节：容器】")
# list 列表：按顺序保存多个元素，可以增删改；下标从 0 开始。
scores = [72, 85, 91]
scores.append(80)      # append() 在列表末尾添加一个元素。
scores[0] = 75        # 修改第一个元素。
print(scores, scores[-1], len(scores))
for score_value in scores:
    print("成绩：", score_value)
# 遍历列表可以直接得到元素，不一定需要使用下标。
# sum(scores) 求和；sum(scores) / len(scores) 可求非空数值列表的平均值。
# 注意：b = a 不会复制列表；需要浅复制时可以写 b = a.copy()。

# tuple 元组：元素位置不能重新赋值，适合表达一组固定数据。
point = (3, 4)
point_x, point_y = point  # 解包：将两个元素分别赋给两个变量。
print("坐标：", point_x, point_y)

# dict 字典：通过键查找值，而不是依靠元素的排列位置。
student = {"name": "小周", "score": 88}
print(student["name"])
student["score"] = 90
student["passed"] = True
for field_name, field_value in student.items():
    print(field_name, field_value)

